&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">IID_PPV_ARGS&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="o">&amp;amp;&lt;/span>&lt;span class="n">depthStencilBuffer&lt;/span>&lt;span class="p">)&lt;/span>
