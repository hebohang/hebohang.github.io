&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="n">device&lt;/span>&lt;span class="o">-&amp;gt;&lt;/span>&lt;span class="n">CreateDescriptorHeap&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="o">&amp;amp;&lt;/span>&lt;span class="n">dsvHeapDesc&lt;/span>&lt;span class="p">,&lt;/span> &lt;span class="n">IID_PPV_ARGS&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="o">&amp;amp;&lt;/span>&lt;span class="n">dsvHeap&lt;/span>&lt;span class="p">));&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="n">CD3DX12_CPU_DESCRIPTOR_HANDLE&lt;/span> &lt;span class="nf">dsvHandle&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="n">dsvHeap&lt;/span>&lt;span class="o">-&amp;gt;&lt;/span>&lt;span class="n">GetCPUDescriptorHandleForHeapStart&lt;/span>&lt;span class="p">());&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="n">device&lt;/span>&lt;span class="o">-&amp;gt;&lt;/span>&lt;span class="n">CreateDepthStencilView&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="n">depthStencilBuffer&lt;/span>&lt;span class="p">.&lt;/span>&lt;span class="n">Get&lt;/span>&lt;span class="p">(),&lt;/span> &lt;span class="k">nullptr&lt;/span>&lt;span class="p">,&lt;/span> &lt;span class="n">dsvHandle&lt;/span>&lt;span class="p">);&lt;/span>
